<Window x:Class="CNNStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CNNStudio" Title="CNN Studio">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="PageLoaded">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleArea" Padding="24,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="Assets/App.png" Width="24" Height="24"/><TextBlock Text="CNN Studio" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="24,8,24,24" RowSpacing="20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="实时视野" Style="{ThemeResource TitleTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0"><Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="#8A8A8A"/><TextBlock x:Name="ConnectionText" Text="正在寻找设备" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
     <ComboBox x:Name="Mode" SelectedIndex="0" SelectionChanged="ModeChanged" Width="132"><ComboBoxItem Content="目标检测"/><ComboBoxItem Content="流畅预览"/></ComboBox>
     <Button x:Name="PauseButton" Click="PauseClicked" ToolTipService.ToolTip="暂停 / 继续"><FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="16"/></Button>
     <Button ToolTipService.ToolTip="设置"><FontIcon Glyph="&#xE713;" FontSize="16"/><Button.Flyout><Flyout><StackPanel Width="240" Spacing="12"><TextBlock Text="画面设置" FontWeight="SemiBold"/><ToggleSwitch x:Name="Boxes" Header="显示检测框" IsOn="True"/><TextBlock Text="亮度"/><Slider x:Name="Brightness" Minimum="-4" Maximum="4" StepFrequency="1" ValueChanged="BrightnessChanged"/><TextBlock Text="置信度"/><Slider x:Name="Confidence" Minimum="0.05" Maximum="0.95" Value="0.5" StepFrequency="0.05" ValueChanged="ThresholdChanged"/><TextBlock Text="重叠阈值"/><Slider x:Name="Overlap" Minimum="0.05" Maximum="0.8" Value="0.3" StepFrequency="0.05" ValueChanged="ThresholdChanged"/><Button Content="查看运行状态" Click="DiagnosticsClicked"/></StackPanel></Flyout></Button.Flyout></Button>
     <Button Click="FullScreenClicked" ToolTipService.ToolTip="全屏"><FontIcon Glyph="&#xE740;" FontSize="16"/></Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ResultsColumn" Width="280"/></Grid.ColumnDefinitions>
    <Border Background="#101722" CornerRadius="16" Padding="12"><Grid>
     <Viewbox Stretch="Uniform" Margin="20"><Grid x:Name="PreviewSurface" Width="416" Height="416" Background="#101722"><Image x:Name="PreviewImage" Width="416" Height="416"/><Canvas x:Name="Overlay" Width="416" Height="416"/></Grid></Viewbox>
     <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"><FontIcon Glyph="&#xE714;" FontSize="40" Foreground="#738094"/><TextBlock Text="等待画面" Foreground="#A4AFBE" HorizontalAlignment="Center"/></StackPanel>
     <Border Background="#B0101722" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock x:Name="FpsText" Text="— fps" Foreground="White" FontSize="12"/></Border>
     <Border x:Name="RecordingBadge" Visibility="Collapsed" Background="#C0101722" CornerRadius="6" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="#FF6565"/><TextBlock x:Name="RecordingTime" Text="REC 00:00" Foreground="White" FontSize="12"/></StackPanel></Border>
    </Grid></Border>
    <Border x:Name="ResultsPanel" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20"><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="发现" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DetectionCount" Text="0" HorizontalAlignment="Right" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Grid><TextBlock x:Name="ResultHint" Grid.Row="1" Text="等待识别" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ListView x:Name="Results" Grid.Row="2" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Width="208" Padding="0,8"><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Confidence}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="SessionText" Grid.Row="3" Text="本次接收 0 帧" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Border>
   </Grid>
   <Grid Grid.Row="2"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="RecordButton" Style="{ThemeResource AccentButtonStyle}" Click="RecordClicked" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7C8;" FontSize="16"/><TextBlock x:Name="RecordLabel" Text="录制"/></StackPanel></Button><Button x:Name="SnapshotButton" Click="SnapshotClicked" IsEnabled="False" ToolTipService.ToolTip="保存画面"><FontIcon Glyph="&#xE722;" FontSize="16"/></Button><Button Click="OpenFolderClicked" ToolTipService.ToolTip="打开保存位置"><FontIcon Glyph="&#xED25;" FontSize="16"/></Button><TextBlock x:Name="ActionHint" VerticalAlignment="Center" Margin="8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel><Button HorizontalAlignment="Right" Click="RotateClicked" ToolTipService.ToolTip="旋转画面"><FontIcon Glyph="&#xE7AD;" FontSize="16"/></Button></Grid>
  </Grid>
 </Grid>
</Window>
