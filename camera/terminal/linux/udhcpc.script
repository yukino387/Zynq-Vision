#!/bin/sh
case "$1" in
    bound|renew)
        ifconfig "$interface" "$ip" netmask "$subnet" up
        if [ -n "$router" ]; then
            for gateway in $router; do
                route add default gw "$gateway" 2>/dev/null || true
                break
            done
        fi
        if [ -n "$dns" ]; then
            : > /etc/resolv.conf
            for server in $dns; do
                echo "nameserver $server" >> /etc/resolv.conf
            done
        fi
        ;;
    deconfig)
        ifconfig "$interface" 0.0.0.0
        ;;
esac
