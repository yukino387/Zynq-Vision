# AMD FSBL initializes DDR/PL; this loader only boots the terminal SD image.
# CONFIG_SPL is not set
# CONFIG_OF_BOARD is not set
CONFIG_OF_SEPARATE=y
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_NAND is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# CONFIG_EFI_CAPSULE_FIRMWARE_RAW is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
# CONFIG_MBEDTLS_LIB is not set
# CONFIG_NET is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_FIT_SIGNATURE is not set
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_FAT=y
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_ZYNQ=y
CONFIG_DEBUG_UART_BASE=0xe0000000
CONFIG_DEBUG_UART_CLOCK=100000000
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_BOOTDELAY=2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="mmc dev 0; mmc rescan; if fatload mmc 0:1 0x02000000 zImage && fatload mmc 0:1 0x08000000 system.dtb; then setenv bootargs console=ttyPS0,115200 root=/dev/mmcblk0p2 rw rootwait cma=64M; bootz 0x02000000 - 0x08000000; fi"
