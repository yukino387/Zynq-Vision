+static int _evdev_character(lv_evdev_t * dsc, uint16_t code)
+{
+    const bool shift = dsc->shift_left || dsc->shift_right;
+    int key = 0;
+    if(code >= KEY_Q && code <= KEY_P) key = "qwertyuiop"[code - KEY_Q];
+    else if(code >= KEY_A && code <= KEY_L) key = "asdfghjkl"[code - KEY_A];
+    else if(code >= KEY_Z && code <= KEY_M) key = "zxcvbnm"[code - KEY_Z];
+    if(key) return (shift != dsc->caps_lock) ? key - 'a' + 'A' : key;
+    if(code >= KEY_1 && code <= KEY_0) return (shift ? "!@#$%^&*()" : "1234567890")[code - KEY_1];
+    switch(code) {
+        case KEY_SPACE: return ' ';
+        case KEY_MINUS: return shift ? '_' : '-';
+        case KEY_EQUAL: return shift ? '+' : '=';
+        case KEY_LEFTBRACE: return shift ? '{' : '[';
+        case KEY_RIGHTBRACE: return shift ? '}' : ']';
+        case KEY_BACKSLASH: return shift ? '|' : 92;
+        case KEY_SEMICOLON: return shift ? ':' : ';';
+        case KEY_APOSTROPHE: return shift ? 34 : 39;
+        case KEY_GRAVE: return shift ? '~' : '`';
+        case KEY_COMMA: return shift ? '<' : ',';
+        case KEY_DOT: return shift ? '>' : '.';
+        case KEY_SLASH: return shift ? '?' : '/';
+        case KEY_TAB: return shift ? LV_KEY_PREV : LV_KEY_NEXT;
+        default: return _evdev_process_key(code);
+    }
+}
+
+static void _evdev_wheel(lv_indev_t * indev, int dx, int dy, lv_point_t point)
+{
+    lv_display_t * display = lv_indev_get_display(indev);
+    lv_obj_t * object = lv_indev_search_obj(lv_display_get_layer_top(display), &point);
+    if(object == NULL) object = lv_indev_search_obj(lv_display_get_screen_active(display), &point);
+    while(object) {
+        const lv_dir_t direction = lv_obj_get_scroll_dir(object);
+        const bool vertical = dy && (direction & LV_DIR_VER) && (lv_obj_get_scroll_top(object) > 0 || lv_obj_get_scroll_bottom(object) > 0);
+        const bool horizontal = dx && (direction & LV_DIR_HOR) && (lv_obj_get_scroll_left(object) > 0 || lv_obj_get_scroll_right(object) > 0);
+        if(lv_obj_has_flag(object, LV_OBJ_FLAG_SCROLLABLE) && (vertical || horizontal)) {
+            lv_obj_scroll_by_bounded(object, horizontal ? -dx * 36 : 0, vertical ? dy * 36 : 0, LV_ANIM_OFF);
+            return;
+        }
+        object = lv_obj_get_parent(object);
+    }
+}
