{
  "name": "iot-vision-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "pnpm --filter @vision/server db:generate && pnpm --filter \"./packages/**\" build",
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm run setup && concurrently -n server,web,mobile \"pnpm dev:server\" \"pnpm dev:web\" \"pnpm dev:mobile\"",
    "dev:server": "pnpm --filter @vision/server dev",
    "dev:web": "pnpm --filter @vision/web dev",
    "dev:mobile": "pnpm --filter @vision/mobile dev",
    "dev:simulator": "pnpm --filter @vision/simulator dev",
    "build": "pnpm -r build",
    "start": "pnpm run setup && pnpm --filter @vision/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages scripts temporary/iot_platform_test --max-warnings 0",
    "format": "prettier --write apps packages scripts docs/*.md",
    "test": "tsx --tsconfig apps/server/tsconfig.json --test --test-concurrency=1 temporary/iot_platform_test/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "fastify": "5.11.3"
    }
  }
}
